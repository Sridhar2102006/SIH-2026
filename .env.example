# ============================================================
# HONEYCHAIN — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================
#
# INSTRUCTIONS:
# Copy this file to '.env' or '.env.local' and supply project-specific values.
# NEVER commit production credentials, secret keys, or live database passwords.

# Application Environment Mode ('development' | 'test' | 'production')
NODE_ENV=development
APP_ENV=development

# Database Configuration (§4, §5)
# In development/test: uses SQLite engine / Neon serverless Postgres
DATABASE_URL=sqlite:honeychain_dev.db
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Backend & Server Ports
PORT=5001
HOST=localhost

# Security & Session Authentication (§16, §31)
JWT_SECRET=honeychain-dev-jwt-signing-secret-replace-in-production
JWT_EXPIRATION=86400
SESSION_COOKIE_NAME=honeychain_session

# CORS & Network Permissions (§30)
CORS_ORIGIN=http://localhost:5173,http://localhost:5001
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend Client Environment (Vite prefixed)
VITE_API_BASE_URL=http://localhost:5001/api
VITE_PUBLIC_VERIFICATION_URL=http://localhost:5173/#verify
VITE_HONEYCHAIN_NETWORK_NAME=HoneyChain Verification Gateway

# Hardware & IoT Gateway (§28)
ESP32_GATEWAY_URL=http://192.168.4.1/api/telemetry
ESP32_TELEMETRY_INTERVAL_MS=30000
ESP32_ONE_SHOT_TIMEOUT_MS=15000

# Reporting & Analytical Storage
REPORT_STORAGE_PATH=./storage/reports
REPORT_DIGEST_ALGORITHM=SHA-256
